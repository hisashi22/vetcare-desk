
{
  "name": "vetcare-desktop",
  "version": "1.0.0",
  "description": "Sistema de gestão veterinária VetCare",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "npm run build:main && node --test dist/main/**/*.test.js"
  },

  
  "dependencies": {
    "dotenv": "^16.4.7",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/sql.js": "^1.4.9",
    "electron": "^35.0.0",
    "typescript": "^5.7.3"
  }
}
